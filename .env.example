# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=

# 1 = synthetic responses for testing without a key. Reports say so loudly.
JEV_MOCK=0
JEV_MODEL=jev-latest
JEV_CONCURRENCY=16
# Served version to report on (e.g. jev-1.13.0). Blank = what JEV_MODEL last served.
REPORT_MODEL=

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
KAFKA_BOOTSTRAP=localhost:19092

# USD per million tokens. Check docs.typesafe.ai/models.
JEV_INPUT_PRICE_PER_M=0.042
JEV_OUTPUT_PRICE_PER_M=0
